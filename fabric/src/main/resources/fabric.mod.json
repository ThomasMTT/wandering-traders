{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${displayname}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "homepage": "${github_url}",
    "sources": "${github_url}",
    "issues": "${github_url}/issues"
  },
  "license": "All Rights Reserved",
  "icon": "${logo}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${mod_group}.${mod_id}.fabric.${classname}Fabric"
    ],
    "client": [
      "${mod_group}.${mod_id}.fabric.${classname}FabricClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.14",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "minecraft": ">=1.19.4"
  }
}